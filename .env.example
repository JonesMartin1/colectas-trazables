# Cuenta de testnet de portal.hedera.com (ECDSA). Copiar a .env y completar. Nunca commitear .env.
# Red: testnet (por defecto) o mainnet. Ver docs/MAINNET.md antes de cambiarla.
HEDERA_NETWORK=testnet
# Opcional: Mirror Node pago para producción (sin /api/v1). Si no está, se usa el público de la red elegida.
MIRROR_NODE_URL=
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=
# Topic de registro (npm run registro lo deja en hedera/estado.json; en Vercel va como variable)
REGISTRO_TOPIC_ID=
# Para la donación de demo en Vercel (en local salen de hedera/estado.json y hedera/.cuentas.json)
USDC_TOKEN_ID=
DEMO_DONANTE_ID=
DEMO_DONANTE_KEY=
# Mercado Pago: access token de PRUEBA de la cuenta de la organización (Checkout Pro). En producción, OAuth por organización.
MP_ACCESS_TOKEN=
# Alta de colectas: hashes SHA-256 de los códigos de alta habilitados, separados por coma (npm run codigo-alta).
# En mainnet es obligatorio; en testnet, sin código la colecta nace "sin verificar". Ver docs/SEGURIDAD.md.
CODIGOS_ALTA_HASH=
# Ids de colectas anteriores al código de alta que ya se validaron a mano, separados por coma.
COLECTAS_VERIFICADAS=
# Conciliación diaria de Mercado Pago: Vercel lo manda solo en los cron.
CRON_SECRET=
